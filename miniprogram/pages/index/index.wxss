.hero {
  background: linear-gradient(135deg, #0052d9 0%, #3f7be0 100%);
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
  color: #ffffff;
  margin-bottom: 32rpx;
}

.hero__date {
  font-size: 24rpx;
  opacity: 0.8;
}

.hero__title {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 600;
}

.hero__summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 40rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.24);
}

.hero__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero__num {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.2;
}

.hero__label {
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.82;
}

.hero__divider {
  width: 1rpx;
  height: 48rpx;
  background-color: rgba(255, 255, 255, 0.24);
}

.task-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.task-card__title {
  font-size: 32rpx;
  font-weight: 600;
}

.task-card__desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #646a73;
}

.dev {
  margin-top: 32rpx;
}

.dev__row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 12rpx 0;
}

.dev__label {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #8a8f99;
}

.dev__value {
  flex: 1;
  margin-left: 24rpx;
  font-size: 26rpx;
  color: #1f2329;
  text-align: right;
  word-break: break-all;
}
