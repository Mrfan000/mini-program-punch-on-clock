.profile {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

/* 去掉 button 默认样式，使其看起来像头像容器 */
.avatar-btn {
  padding: 0;
  margin: 0;
  width: 128rpx;
  height: 128rpx;
  line-height: 1;
  background-color: transparent;
  border-radius: 50%;
  flex-shrink: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: block;
  background-color: #f2f3f5;
}

.avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 600;
  color: #0052d9;
  background-color: #e8f0fe;
}

.profile__body {
  flex: 1;
  margin-left: 28rpx;
  min-width: 0;
}

.profile__nickname {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2329;
  height: 56rpx;
  line-height: 56rpx;
}

.profile__nickname-ph {
  color: #a6a9ad;
  font-weight: 400;
  font-size: 30rpx;
}

.profile__id {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a6a9ad;
  word-break: break-all;
}

.stat-row {
  display: flex;
  align-items: center;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat__num {
  font-size: 40rpx;
  font-weight: 600;
  color: #1f2329;
}

.stat__label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #646a73;
}

.action {
  margin-top: 40rpx;
}

.action__tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #a6a9ad;
}
