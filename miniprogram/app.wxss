/**
 * 全局样式
 * 设计变量参考 TDesign 品牌色，保持与组件库一致
 */

page {
  --td-brand-color: #0052d9;
  --td-success-color: #2ba471;
  --td-warning-color: #e37318;
  --td-error-color: #d54941;

  --color-primary: #0052d9;
  --color-success: #2ba471;
  --color-text: #1f2329;
  --color-text-secondary: #646a73;
  --color-text-placeholder: #a6a9ad;
  --color-border: #e7e9eb;
  --color-bg-page: #f5f6f8;
  --color-bg-card: #ffffff;

  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;

  background-color: var(--color-bg-page);
  color: var(--color-text);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Helvetica,
    'Microsoft YaHei', sans-serif;
  line-height: 1.5;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.card {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.card__title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.section__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section__title {
  font-size: 34rpx;
  font-weight: 600;
}

.section__more {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.text-secondary {
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
}

.empty__text {
  font-size: 30rpx;
  color: var(--color-text-secondary);
}

.empty__desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-placeholder);
}

.divider {
  height: 1rpx;
  background-color: var(--color-border);
  margin: 24rpx 0;
}
